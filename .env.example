# Esta versão usa SQLite local e não requer variáveis de ambiente para o app.
# Configure futuras chaves de API em .env, nunca publique segredos no GitHub.

# Módulo de Cybersecurity (backend local)
PORT=3333
HOST=0.0.0.0
SECURITY_DEMO_TOKEN=trajetoria-demo
SECURITY_ENCRYPTION_KEY=troque-esta-chave-em-producao
SECURITY_DATA_DIR=backend/data

# IA opcional: sem chaves, o dashboard usa o tradutor local de demonstração.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Integração opcional do app com o backend
EXPO_PUBLIC_SECURITY_API_URL=http://localhost:3333
EXPO_PUBLIC_SECURITY_TOKEN=trajetoria-demo
