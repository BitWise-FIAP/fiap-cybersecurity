{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-security",
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "backend/**/*.ts",
    "src/security/**/*.ts",
    "scripts/**/*.ts",
    "tests/security/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-security",
    "docs"
  ]
}
