{
  "name": "trajetoria-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check": "tsc --noEmit",
    "doctor": "expo-doctor",
    "test:db": "python tests/test_schema.py",
    "security:build": "tsc -p tsconfig.security.json",
    "security:start": "npm run security:build && node dist-security/backend/server.js",
    "security:test": "npm run security:build && node --test dist-security/tests/security/pii.test.js dist-security/tests/security/taint.test.js dist-security/tests/security/risk.test.js dist-security/tests/security/crypto.test.js dist-security/tests/security/aiTranslator.test.js dist-security/tests/security/server.test.js",
    "security:audit": "npm run security:build && node dist-security/scripts/taint-analysis.js",
    "security:demo": "npm run security:build && node dist-security/scripts/security-demo.js",
    "security:evidence": "npm run security:build && node dist-security/scripts/generate-evidence.js",
    "security:report": "npm run security:build && node dist-security/scripts/generate-report.js",
    "security:pdf": "powershell -ExecutionPolicy Bypass -File scripts/generate-security-pdf.ps1",
    "security:dashboard-shot": "powershell -ExecutionPolicy Bypass -File scripts/capture-dashboard.ps1",
    "security:zip": "powershell -ExecutionPolicy Bypass -File scripts/package-cyber.ps1",
    "security:all": "npm run security:test && npm run security:audit && npm run security:demo && npm run security:evidence && npm run security:report && npm run security:pdf && npm run security:zip"
  },
  "dependencies": {
    "expo": "~57.0.32",
    "expo-router": "~57.0.30",
    "expo-sqlite": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-constants": "~57.0.23",
    "expo-linking": "~57.0.13",
    "@expo/vector-icons": "^15.0.2",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/jost": "^0.4.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "expo-crypto": "~57.0.4",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3",
    "expo-doctor": "^1.18.0",
    "babel-preset-expo": "~57.0.17"
  }
}
